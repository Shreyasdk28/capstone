    <vehicle id="car3" type="car" route="E2W_route" depart="4"/>
    <vehicle id="car4" type="car" route="W2E_route" depart="6"/>
    <vehicle id="car5" type="car" route="N2S_route" depart="8"/>
    <vehicle id="car6" type="car" route="S2N_route" depart="10"/>
