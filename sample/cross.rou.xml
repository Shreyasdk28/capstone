<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle types -->
   
<vType id="car" accel="2.0" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="70" color="1,0,0" guiShape="passenger"/>
