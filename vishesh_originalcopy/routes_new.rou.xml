<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle types -->
    <vType id="car" vClass="passenger" speedDev="0.1" sigma="0.5" minGap="2.5" accel="2.6" decel="4.5" length="4.5"/>
    <vType id="bus" vClass="bus" speedDev="0.1" sigma="0.4" minGap="3.0" accel="1.5" decel="3.0" length="12.0"/>
    <vType id="truck" vClass="truck" speedDev="0.1" sigma="0.6" minGap="3.0" accel="1.3" decel="2.5" length="16.0"/>
    <vType id="emergency" vClass="emergency" speedDev="0.1" sigma="0.3" minGap="2.5" accel="3.0" decel="5.0" length="5.0"/>

    <!-- Routes using actual edges from the network -->
    <route id="r0" edges="-1100799178 -1100799179#0"/>
    <route id="r1" edges="-1100799179#0 -1100799178"/>
    <route id="r2" edges="-1100799151#0 -1100799151#1 -1100799178"/>
    <route id="r3" edges="-1100799179#1 -1100799179#0 -1100799178"/>
    
    <!-- Vehicle flows -->
    <!-- Cars -->
    <flow id="car_flow1" type="car" route="r0" begin="0" end="3600" period="60" departLane="allowed" departSpeed="max"/>
    <flow id="car_flow2" type="car" route="r1" begin="0" end="3600" period="60" departLane="allowed" departSpeed="max"/>
    
    <!-- Buses -->
    <flow id="bus_flow1" type="bus" route="r2" begin="0" end="3600" period="300" departLane="allowed" departSpeed="max"/>
    
    <!-- Trucks -->
    <flow id="truck_flow1" type="truck" route="r3" begin="600" end="3000" period="300" departLane="allowed" departSpeed="max"/>
    
    <!-- Emergency vehicles -->
    <flow id="emergency_flow" type="emergency" route="r0" begin="0" end="3600" period="1200" departLane="allowed" departSpeed="max"/>
</routes>
